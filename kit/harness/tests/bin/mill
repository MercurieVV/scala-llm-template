#!/bin/sh
# Test double for ./mill: records its arguments and exits with MILL_STUB_EXIT (default 0).
printf 'mill %s\n' "$*" >> "${MILL_STUB_LOG:-/dev/null}"
# MILL_STUB_ENV_LOG names a file that records the MILL_OUTPUT_DIR each call saw (`<unset>` when unset): how a
# case asserts the gate's wrapper ran Mill in the agent's output directory.
if [ -n "${MILL_STUB_ENV_LOG:-}" ]; then printf 'MILL_OUTPUT_DIR=%s\n' "${MILL_OUTPUT_DIR-<unset>}" >> "$MILL_STUB_ENV_LOG"; fi
# MILL_STUB_HOLDOUT_ENV_LOG likewise records the DSH_HOLDOUT_DIR each call saw (`<unset>` when unset): how a case
# asserts that only the gate's holdout run is told where the holdout sources are (spec 2026-10-02 §10). A separate
# file, so the MILL_OUTPUT_DIR log keeps one kind of line.
if [ -n "${MILL_STUB_HOLDOUT_ENV_LOG:-}" ]; then printf 'DSH_HOLDOUT_DIR=%s\n' "${DSH_HOLDOUT_DIR-<unset>}" >> "$MILL_STUB_HOLDOUT_ENV_LOG"; fi
# MILL_STUB_CALL_ENV_LOG records `MILL_OUTPUT_DIR=<value> <arguments>` per call: how a case asserts WHICH call
# built in which output directory (the holdout run in out-holdout, the rest in the agent's).
if [ -n "${MILL_STUB_CALL_ENV_LOG:-}" ]; then printf 'MILL_OUTPUT_DIR=%s %s\n' "${MILL_OUTPUT_DIR-<unset>}" "$*" >> "$MILL_STUB_CALL_ENV_LOG"; fi
# MILL_STUB_FIXRANGES_SCRIPT names a script run for `<module>.fixRanges` (cwd = the scratch root, Mill's own
# arguments passed through, so it can tell the module and read the ranges file): how a
# fixture simulates purrism rewriting a file. MILL_STUB_COMPILE_FAIL_MARK is a word whose presence in any
# `.scala` file under the cwd makes `<module>.compile` fail. It is keyed on CONTENT, not on a marker
# file, on purpose: the gate undoes a breaking rewrite by restoring the originals, and a content marker
# disappears with the revert, so the compile that follows passes, exactly as it would for real.
#
# `fixRanges` takes its ranges file as the NAMED argument `--rangesFile <path>`: real Mill 1.1.8 rejects
# a positional argument for a `Task.Command(String)` parameter (`Missing argument: --rangesFile <str>`).
# The stub enforces the same, so a positional caller fails here as it would for real instead of a
# fixture passing on an invocation the real build refuses. Every other call — `moduleMap`,
# `MILL_STUB_EXIT` — behaves exactly as before.
# `<module>.stainlessVerify` (spec 2026-09-27 §3) prints the file MILL_STUB_STAINLESS_OUT names (a real
# capture from kit/recipes/mill/stainless-feasibility.md, or a case's own) and exits
# MILL_STUB_STAINLESS_EXIT (default 0) -- `./mill` exits 1 for the script's exit 1 AND 2, so a case sets
# 1 for both and the output's marker lines tell them apart, as they do for real. Like fixRanges it
# requires the NAMED argument `--targets <files>`: Mill 1.1.8 rejects a positional one. The gate's `--no-server`
# (a Mill global option, before the task) is accepted and recorded like any other argument.
case "$*" in
  *.stainlessVerify*)
    case " $* " in
      *" --targets "?*) ;;
      *) printf '[error] stub mill: stainlessVerify needs --targets <files> (real Mill rejects a positional argument): %s\n' "$*" >&2
         exit 97 ;;
    esac
    # MILL_STUB_STAINLESS_SLEEP: seconds to sleep first -- a Stainless run that outlives the gate's cap.
    if [ -n "${MILL_STUB_STAINLESS_SLEEP:-}" ]; then sleep "$MILL_STUB_STAINLESS_SLEEP"; fi
    if [ -n "${MILL_STUB_STAINLESS_OUT:-}" ] && [ -f "$MILL_STUB_STAINLESS_OUT" ]; then
      cat "$MILL_STUB_STAINLESS_OUT"
    fi
    exit "${MILL_STUB_STAINLESS_EXIT:-0}" ;;
esac
case "$*" in
  *.fixRanges*)
    case " $* " in
      *" --rangesFile "?*) ;;
      *) printf '[error] stub mill: fixRanges needs --rangesFile <path> (real Mill rejects a positional argument): %s\n' "$*" >&2
         exit 97 ;;
    esac
    if [ -n "${MILL_STUB_FIXRANGES_SCRIPT:-}" ] && [ -f "$MILL_STUB_FIXRANGES_SCRIPT" ]; then
      sh "$MILL_STUB_FIXRANGES_SCRIPT" "$@"
    fi
    printf 'fixRanges: applied 0\n'
    exit 0 ;;
  *.compile*)
    if [ -n "${MILL_STUB_COMPILE_FAIL_MARK:-}" ] && grep -rqs --include='*.scala' "$MILL_STUB_COMPILE_FAIL_MARK" .; then
      printf '[error] core/src/T.scala:3:1 the rewrite broke this\n'
      exit 1
    fi ;;
esac
if [ "${1:-}" = "moduleMap" ] && [ -n "${MILL_STUB_MAP:-}" ]; then
  cat "$MILL_STUB_MAP"
fi
exit "${MILL_STUB_EXIT:-0}"
