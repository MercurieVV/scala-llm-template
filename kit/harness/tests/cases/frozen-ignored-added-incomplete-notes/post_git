#!/bin/sh
# git-ignored frozen files: `local/` and `.dsh/.state/` ignored through .git/info/exclude (a root/.gitignore
# would ignore the fixture files themselves in this repository).
mkdir -p .git/info
printf 'local/\n.dsh/.state/\n' >> .git/info/exclude
mkdir -p local
printf 'k\n' > local/k.txt
engine=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
printf 's\n' > local/secret.txt; chmod 000 local/secret.txt
GATE_ROOT="$PWD" "${GATE_SH:-sh}" "$engine/gate.sh" baseline < "$(dirname -- "$0")/payload.json" >/dev/null || exit 1
# An incomplete record: the unreadable file is on disk but not in the record, so an added-path check
# would call it new. Not done: a note only.
chmod 600 local/secret.txt
printf 'override\n' > local/override.conf
