#!/bin/sh
mkdir -p .dsh/.state/contracts
# `.dsh/.state` NOT git-ignored: SessionStart writes this session's contract snapshot (untracked,
# frozen) and the baseline records its hash. Rewritten afterwards by an ungated route -> block (it is NOT the gate's own write).
engine=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
GATE_ROOT="$PWD" "${GATE_SH:-sh}" "$engine/gate.sh" baseline < "$(dirname -- "$0")/payload.json" || exit 1
[ -f .dsh/.state/contracts/s1.tsv ] || { echo "no snapshot written"; exit 1; }
printf x >> .dsh/.state/contracts/s1.tsv
