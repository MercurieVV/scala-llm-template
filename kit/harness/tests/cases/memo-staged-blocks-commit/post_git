#!/bin/sh
# The memo-table-blocks change, staged: a commit is what the repository keeps, so the same finding
# must block there too.
{
  printf '  val table = Map(\n'
  i=1
  while [ "$i" -le 10 ]; do
    printf '    "k%s" -> %s,\n' "$i" "$i"
    i=$((i + 1))
  done
  printf '  )\n'
} >> core/src/T.scala
git add core/src/T.scala
