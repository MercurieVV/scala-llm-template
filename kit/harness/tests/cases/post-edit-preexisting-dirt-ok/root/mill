#!/bin/sh
# A Mill that fails `checkFormat` the way the real one does on a dirty module: it prints one
# absolute path per misformatted file — here a file this turn did NOT edit, which is the whole
# point of F53 — and exits 1. Every other task succeeds.
printf 'mill %s\n' "$*" >> "${MILL_STUB_LOG:-/dev/null}"
case "$*" in
  *checkFormat*)
    root=$(pwd)
    printf 'Checking format of 2 Scala sources\n'
    printf 'parsed config (v3.10.7): %s/.scalafmt.conf\n' "$root"
    printf '%s\n' "$root/engine/details/src/Dirty.scala"
    printf '[error] engine.details.checkFormat Found 1 misformatted files\n'
    exit 1 ;;
esac
exit 0
