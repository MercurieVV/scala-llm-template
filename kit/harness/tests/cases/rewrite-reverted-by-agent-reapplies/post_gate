#!/bin/sh
# The second turn-end rewrote the line again and blocked again, still naming the suppression.
second=$(awk 'f { print } /^--- second run \(exit / { f = 1 }' "$GATE_OUT_FILE")
printf '%s\n' "$second" | grep -Fq 'purrism rewrote the lines you changed' || { echo "the second run did not re-apply"; exit 1; }
printf '%s\n' "$second" | grep -Fq 'scalafix:ok' || { echo "the second run does not name scalafix:ok"; exit 1; }
[ "$(grep -c 'core.fixRanges --rangesFile' mill.log)" = 2 ] || { echo "fixRanges did not run on both turn-ends"; exit 1; }
echo "re-applied on the second turn-end"
