#!/bin/sh
# After the base commit: the turn edits a file in `core` (no scalafix) and one in `app` (scalafix).
# The session starts on a clean tree (the SessionStart baseline has no rows): the rewrite stage runs
# only under a session baseline, and every edit below is the session's own.
engine=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
GATE_ROOT="$PWD" "${GATE_SH:-sh}" "$engine/gate.sh" baseline < "$(dirname -- "$0")/payload.json" || exit 1
printf '  def f(o: Option[Int]): Int = o.get\n' >> core/src/T.scala
printf '  def g(o: Option[Int]): Int = o.get\n' >> app/src/A.scala
