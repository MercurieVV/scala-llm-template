#!/bin/sh
# pre_gate: let the GATE build the coverage cache (one read of the covered file), then remove that
# file's `.semanticdb` -- what `./mill <module>.clean` does. The cache must not keep denying a read
# that nothing covers any more: that is F72's deadlock, reintroduced by the cache itself.
#
# The setup drives the gate rather than the lib.sh helpers on purpose: the gate is the interface this
# fixture is about, so the fixture means the same thing against any version of the harness (measured:
# against the pre-fix guard this case fails on the VERDICT, not on its own setup).
set -u
engine=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
root=$(pwd)
idx=out/mod/semanticDbDataDetailed.dest/classes/META-INF/semanticdb/engine/shape/src/A.scala.semanticdb
printf '{"tool_name":"read","tool_input":{"file_path":"engine/shape/src/A.scala"}}' > .dsh/pre-gate-payload.json
GATE_ROOT="$root" PATH="$engine/tests/bin:$PATH" "${GATE_SH:-sh}" "$engine/gate.sh" semantic-guard \
  < .dsh/pre-gate-payload.json >/dev/null 2>&1
[ -s .dsh/.state/index-coverage ] || { echo "pre_gate: the gate did not write a coverage cache"; exit 1; }
rm -f "$root/$idx"
[ -f "$root/$idx" ] && { echo "pre_gate: the index file is still there"; exit 1; }
printf 'pre_gate: cache written by the gate, then the index file removed\n'
