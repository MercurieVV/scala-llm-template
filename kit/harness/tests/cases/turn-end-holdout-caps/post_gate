#!/bin/sh
rm -rf "$SCRATCH_ROOT.holdout"
[ "$(grep -c '^  - ' "$GATE_OUT_FILE")" = 20 ] || { echo "FAIL: not exactly 20 names"; grep '^  - ' "$GATE_OUT_FILE"; exit 1; }
if grep -q 'case number 20' "$GATE_OUT_FILE"; then echo "FAIL: 21st name printed"; exit 1; fi
[ "$(grep '^  - ' "$GATE_OUT_FILE" | awk '{ if (length($0) > m) m = length($0) } END { print m }')" = 124 ] || { echo "FAIL: long name not cut to 120"; exit 1; }
echo "post_gate: caps held"
