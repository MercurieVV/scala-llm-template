#!/bin/sh
# Ruling 29 M1: holdoutDir declares no test -- the failing run's names cannot be verified against anything, and the
# report says "not verified" (not "failed — 0 verified"). post_gate removes the directory.
mkdir -p "$SCRATCH_ROOT.holdout"
printf '%s\n' 'object Helper { val x = 1 }' > "$SCRATCH_ROOT.holdout/Helper.scala"
# Unique per scratch root (parallel runs share TMPDIR): point the contract at it.
sed "s|^holdoutDir = .*|holdoutDir = $SCRATCH_ROOT.holdout|" .dsh/contract > .dsh/contract.tmp && mv .dsh/contract.tmp .dsh/contract
