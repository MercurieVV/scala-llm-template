#!/bin/sh
# holdoutDir is a real directory outside the scratch root; post_gate removes it. It holds the sources the
# reported names must occur in (verified names only reach the agent).
mkdir -p "$SCRATCH_ROOT.holdout"
printf '%s\n' 'test("stop releases device")' 'test("a second failure")' > "$SCRATCH_ROOT.holdout/PlaybackHoldout.scala"
# Unique per scratch root (parallel runs share TMPDIR): point the contract at it.
sed "s|^holdoutDir = .*|holdoutDir = $SCRATCH_ROOT.holdout|" .dsh/contract > .dsh/contract.tmp && mv .dsh/contract.tmp .dsh/contract
