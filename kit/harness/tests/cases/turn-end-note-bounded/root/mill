#!/bin/sh
# A checkFormat failure whose diagnostics run to kilobytes, all of them about a file this turn did not
# touch: the note must be bounded before it is handed to an agent (the shared byte bound, F59).
printf 'mill %s\n' "$*" >> "${MILL_STUB_LOG:-/dev/null}"
case "$*" in
  *checkFormat*)
    root=$(pwd)
    printf 'Checking format of 2 Scala sources\n'
    i=1
    while [ "$i" -le 60 ]; do
      printf '%s/engine/details/src/Dirty.scala: this pre-existing file is misformatted and its diagnostic is long enough to matter %s\n' "$root" "$i"
      i=$((i + 1))
    done
    exit 1 ;;
esac
exit 0
