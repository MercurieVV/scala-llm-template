#!/bin/sh
# The launcher's real reason sits BENEATH four JVM deprecation warnings. The note must quote the
# reason, never the warnings -- expect.grep can only require presence, so the absence is asserted here.
if grep -q 'sun.misc.Unsafe' "$GATE_OUT_FILE"; then
  echo "JVM warning leaked into the note:"; cat "$GATE_OUT_FILE"; exit 1
fi
echo "NO_JVM_NOISE_IN_REASON"
