package build.buildKit

import mill._
import mill.scalalib._
import com.goyeau.mill.scalafix.ScalafixModule
import scala.jdk.CollectionConverters.*
import scala.jdk.OptionConverters.*
import build.BuildPaths

/** The Mill side of the harness engine's interface (scala-llm-template kit/harness, spec 2026-09-26 §3). The engine
  * runs these by name: `<module>.fixStrict`, `<module>.fixRanges --rangesFile <path>`, and the root tasks the recipe's
  * §7 writes over `Gate`'s helpers (`moduleMap`, `scalaSemanticWriteClasspath`, `preCommit`, `prePush`).
  */
trait GateLayer extends ScalafixModule {
  /** `fix("--check")`'s exit code reflects only `ScalafixArguments#run()`'s `ScalafixError[]`, never a report-only lint finding at WARNING/INFO —
    * true even of Purrism's rules, which hardcode `severity` and bypass `.scalafix.conf`'s `lint.error` (confirmed by testing directly).
    * `#evaluate()` (the same embedding API Metals/Bloop use) returns every diagnostic regardless of severity, so failing on a nonempty list here
    * is the only way to make a warning fatal.
    */
  def fixStrict: T[Unit] = Task {
    val filesToFix = ScalafixModule.filesToFix(sources()).map(_.path)
    if filesToFix.nonEmpty then
      val toolJars = (scalafixToolClasspath() ++ defaultResolver().classpath(scalafixIvyDeps()))
        .map(_.path.toNIO.toUri.toURL)
      val classpath =
        (compileClasspath() ++ localClasspath() ++ Seq(semanticDbData())).iterator.toSeq
          .map(_.path.toNIO.toAbsolutePath)
      val sf = scalafix.interfaces.Scalafix.fetchAndClassloadInstance(scalaVersion())
      val args = sf
        .newArguments()
        .withToolClasspath(toolJars.asJava)
        .withWorkingDirectory(BuildPaths.repoRoot.toNIO.toAbsolutePath)
        .withConfig(scalafixConfig().map(_.toNIO.toAbsolutePath).toJava)
        .withClasspath(classpath.asJava)
        .withScalaVersion(scalaVersion())
        .withScalacOptions(scalacOptions().asJava)
        .withPaths(filesToFix.map(_.toNIO.toAbsolutePath).asJava)
      val eval = args.evaluate()
      eval.getErrorMessage.toScala.foreach(msg => Task.log.error(msg))
      val diags = eval.getFileEvaluations.iterator
        .flatMap(fe => fe.getDiagnostics.iterator.map(fe.getEvaluatedFile -> _))
        .toSeq
      if diags.isEmpty then mill.api.Result.Success(())
      else
        val msgs = diags.map { case (file, d) =>
          val pos = d.position.toScala.map(p => s":${p.startLine + 1}:${p.startColumn + 1}").getOrElse("")
          // The full lint id (`Rule.kind`), the same text scalafix's own CLI prints and the finding code the
          // harness joins on (.dsh/instructions/*.tsv); the rule name alone when the id has no category.
          val rule = d.lintID.toScala
            .map(id => if id.categoryID.isEmpty then s"[${id.ruleName}]" else s"[${id.ruleName}.${id.categoryID}]")
            .getOrElse("")
          s"[${d.severity}]$rule $file$pos ${d.message}"
        }
        mill.api.Result.Failure(s"scalafix found ${diags.length} diagnostic(s):\n${msgs.mkString("\n")}")
    else mill.api.Result.Success(())
  }

  /** Applies only the scalafix patches whose every text edit lies inside one of the given line ranges
    * (spec 2026-09-25-purrism-loop-and-memorisation-design §2). `rangesFile` holds `path TAB startLine
    * TAB endLine` rows — root-relative path, 0-based, end-exclusive, the format `.dsh/lib.sh`'s
    * `dsh_diff_ranges` writes. Code the agent did not write is never rewritten without review: a patch
    * with any edit outside the ranges is left alone, and an atomic patch that reaches outside is skipped
    * whole rather than split. Prints `fixRanges: applied N` last; exits 0 only when every range was
    * read, every file evaluated and every kept patch applied — any other outcome is a named failure.
    */
  def fixRanges(rangesFile: String) = Task.Command {
    val rangesPath = os.Path(rangesFile, BuildPaths.repoRoot)
    val linesOrErr =
      try Right(os.read.lines(rangesPath))
      catch case e: Exception => Left(s"fixRanges: cannot read ranges file $rangesFile: ${e.getMessage}")
    val parsed: Either[String, Vector[(String, Int, Int)]] = linesOrErr.flatMap { lines =>
      lines.zipWithIndex.foldLeft[Either[String, Vector[(String, Int, Int)]]](Right(Vector.empty)) {
        case (acc, (line, idx)) =>
          acc.flatMap { rows =>
            if line.isBlank then Right(rows)
            else
              line.split('\t') match
                case Array(p, s, e) =>
                  (s.trim.toIntOption, e.trim.toIntOption) match
                    case (Some(from), Some(until)) => Right(rows :+ (p, from, until))
                    case _ => Left(s"fixRanges: malformed ranges line ${idx + 1}: $line")
                case _ => Left(s"fixRanges: malformed ranges line ${idx + 1}: $line")
          }
      }
    }
    parsed match
      case Left(msg) => mill.api.Result.Failure(msg)
      case Right(rows) =>
        val ranges: Map[String, Seq[(Int, Int)]] = rows.groupMap(_._1)(r => (r._2, r._3))
        val files = ScalafixModule.filesToFix(sources()).map(_.path)
          .filter(f => ranges.contains(f.relativeTo(BuildPaths.repoRoot).toString))
        if files.isEmpty then
          println("fixRanges: applied 0")
          mill.api.Result.Success(())
        else
          val toolJars = (scalafixToolClasspath() ++ defaultResolver().classpath(scalafixIvyDeps()))
            .map(_.path.toNIO.toUri.toURL)
          val classpath = (compileClasspath() ++ localClasspath() ++ Seq(semanticDbData())).iterator.toSeq
            .map(_.path.toNIO.toAbsolutePath)
          val sf = scalafix.interfaces.Scalafix.fetchAndClassloadInstance(scalaVersion())
          val eval = sf
            .newArguments()
            .withToolClasspath(toolJars.asJava)
            .withWorkingDirectory(BuildPaths.repoRoot.toNIO.toAbsolutePath)
            .withConfig(scalafixConfig().map(_.toNIO.toAbsolutePath).toJava)
            .withClasspath(classpath.asJava)
            .withScalaVersion(scalaVersion())
            .withScalacOptions(scalacOptions().asJava)
            .withPaths(files.map(_.toNIO.toAbsolutePath).asJava)
            .evaluate()
          eval.getErrorMessage.toScala match
            case Some(msg) => mill.api.Result.Failure(s"fixRanges: scalafix could not run: $msg")
            case None =>
              // A file scalafix could not evaluate (stale SemanticDB, a parse error) yields no patches, and a
              // patch that could not be written changes nothing: both would read as "nothing to rewrite"
              // under exit 0. Each is collected and fails the command by name — exit 0 means every file
              // was evaluated and every kept patch applied.
              var applied = 0
              val failures = scala.collection.mutable.ListBuffer.empty[String]
              eval.getFileEvaluations.foreach { fe =>
                val rel = os.Path(fe.getEvaluatedFile).relativeTo(BuildPaths.repoRoot).toString
                if !fe.isSuccessful then
                  val why = fe.getErrorMessage.toScala.orElse(fe.getError.toScala.map(_.toString)).getOrElse("unknown error")
                  failures += s"could not evaluate $rel: $why"
                else
                  val fileRanges = ranges.getOrElse(rel, Nil)
                  def inside(e: scalafix.interfaces.ScalafixTextEdit): Boolean =
                    val p = e.position
                    fileRanges.exists((from, until) => p.startLine >= from && p.endLine < until)
                  val keep = fe.getPatches.filter(p => p.textEdits.nonEmpty && p.textEdits.forall(inside))
                  if keep.nonEmpty then
                    val errs = fe.applyPatches(keep)
                    if errs.isEmpty then applied += keep.length
                    else failures += s"could not apply to $rel: ${errs.mkString(", ")}"
              }
              println(s"fixRanges: applied $applied")
              if failures.isEmpty then mill.api.Result.Success(())
              else mill.api.Result.Failure(s"fixRanges: ${failures.length} file(s) failed:\n${failures.mkString("\n")}")
  }
}

object Gate {
  def moduleId(module: Module): String = module.moduleSegments.parts.mkString(".")

  /** `<dir>\t<module id>\t<capabilities>` per module, sorted — the format `.dsh/engine/module-map.sh` reads. The rows
    * come from walking the module tree, so a module added to the build cannot silently drop out of the map. A module
    * `isFormattable` accepts gets a row; so does any other `JavaModule` that is not a `TestModule`. Capabilities:
    * `fmt` (in `main`), `scalafix` (in `scalafix`), `tests` (a direct child `TestModule` named `test` that is in
    * `main ++ testCompile`, so `<id>.test.compile` resolves).
    */
  def moduleMapRows(
      root: Module,
      repoRoot: os.Path,
      isFormattable: Module => Boolean,
      main: Seq[Module],
      scalafix: Seq[Module],
      testCompile: Seq[Module]
  ): Seq[String] = {
    val fmtIds      = main.map(moduleId).toSet
    val scalafixIds = scalafix.map(moduleId).toSet
    val testIds     = (main ++ testCompile).map(moduleId).toSet

    def row(module: Module): String = {
      val capabilities =
        (if (fmtIds.contains(moduleId(module))) Seq("fmt") else Nil) ++
          (if (scalafixIds.contains(moduleId(module))) Seq("scalafix") else Nil) ++
          (if (
             module.moduleDirectChildren.exists {
               case test: TestModule =>
                 test.moduleSegments.parts.lastOption.contains("test") && testIds.contains(moduleId(test))
               case _ => false
             }
           ) Seq("tests")
           else Nil)
      s"${module.moduleDir.relativeTo(repoRoot)}\t${moduleId(module)}\t${capabilities.mkString(",")}"
    }

    def rowsOf(module: Module): Seq[String] =
      module.moduleDirectChildren.toSeq.flatMap { child =>
        val own =
          if (isFormattable(child)) Some(row(child))
          else
            child match {
              case _: TestModule          => None
              case compilable: JavaModule => Some(row(compilable))
              case _                      => None
            }
        own.toSeq ++ rowsOf(child)
      }

    rowsOf(root).sorted
  }

  /** The `classpath-mill.json` format the ScalaSemantic server reads. */
  object ClasspathMetadata {
  final case class Module(id: String, baseDir: os.Path, scalaVersion: String, classpath: Seq[os.Path])

  def metadataPath(root: os.Path): os.Path = root / ".scala-semantic" / "classpath-mill.json"

  def render(root: os.Path, modules: Seq[Module]): String = {
    val renderedModules = modules.map(renderModule(root, _)).mkString(",\n")
    s"""|{
        |  "schemaVersion": 1,
        |  "buildTool": "mill",
        |  "modules": [
        |$renderedModules
        |  ]
        |}
        |""".stripMargin
  }

  def writeIfChanged(path: os.Path, content: String): Boolean = {
    val normalized = if (content.endsWith("\n")) content else content + "\n"
    if (os.exists(path) && os.read(path) == normalized) false
    else {
      os.makeDir.all(path / os.up)
      val tmp = (path / os.up) / s".${path.last}.tmp"
      os.write.over(tmp, normalized)
      os.move.over(tmp, path)
      true
    }
  }

  private def renderModule(root: os.Path, module: Module): String = {
    val cp = module.classpath.distinct.map(p => s"      ${jsonString(pathString(root, p))}").mkString(",\n")
    s"""|    {
        |      "id": ${jsonString(module.id)},
        |      "baseDir": ${jsonString(pathString(root, module.baseDir))},
        |      "scalaVersion": ${jsonString(module.scalaVersion)},
        |      "configuration": "Compile",
        |      "classpath": [
        |$cp
        |      ]
        |    }""".stripMargin
  }

  def pathString(root: os.Path, path: os.Path): String =
    if (path.startsWith(root)) path.relativeTo(root).toString else path.toString

  def jsonString(value: String): String =
    "\"" + value.flatMap {
      case '"'          => "\\\""
      case '\\'         => "\\\\"
      case '\b'         => "\\b"
      case '\f'         => "\\f"
      case '\n'         => "\\n"
      case '\r'         => "\\r"
      case '\t'         => "\\t"
      case c if c < ' ' => "\\u%04x".format(c.toInt)
      case c            => c.toString
    } + "\""
  }
}
